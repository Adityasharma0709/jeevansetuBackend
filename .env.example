# Database URL used by Prisma.
# Example for AWS RDS Postgres:
# DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@your-rds-endpoint.region.rds.amazonaws.com:5432/jeevansetudb?sslmode=require"
DATABASE_URL="postgresql://user:password@host:port/db"

# Database Configuration (for connection parameters if used in local scripts)
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=postgres

# Auth Configuration
JWT_SECRET="change-this-secret"

# Server Port
PORT=3000
  